# Class: pizzatutorial:MeatTopping (pizzatutorial:MeatTopping)

SubClassOf(pizzatutorial:MeatTopping pizzatutorial:PizzaTopping)

# Class: pizzatutorial:MediumVeggiePizza (pizzatutorial:MediumVeggiePizza)

EquivalentClasses(pizzatutorial:MediumVeggiePizza ObjectIntersectionOf(pizzatutorial:VegetarianPizza ObjectAllValuesFrom(pizzatutorial:hasTopping ObjectSomeValuesFrom(pizzatutorial:hasSpiciness ObjectHasValue(pizzatutorial:isMilderThan pizzatutorial:Hot)))))

