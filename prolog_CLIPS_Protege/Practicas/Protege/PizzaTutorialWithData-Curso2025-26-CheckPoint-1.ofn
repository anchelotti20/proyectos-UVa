DLSafeRule(Annotation(swrla:isRuleEnabled "true"^^xsd:boolean) Annotation(rdfs:comment "Descuento para clientes que prefieren pizzas menos picantes") Annotation(rdfs:label "LessSpicyDiscountRule") Body(ClassAtom(pizzatutorial:Customer Variable(pizzatutorial:c)) DataPropertyAtom(pizzatutorial:numberOfPizzasPurchased Variable(pizzatutorial:c) Variable(pizzatutorial:np)) ObjectPropertyAtom(pizzatutorial:hasSpicinessPreference Variable(pizzatutorial:c) Variable(pizzatutorial:spr)) BuiltInAtom(swrlb:greaterThan Variable(pizzatutorial:np) "1"^^xsd:integer) ObjectPropertyAtom(pizzatutorial:isMilderThan Variable(pizzatutorial:spr) pizzatutorial:Hot))Head(DataPropertyAtom(pizzatutorial:hasDiscount Variable(pizzatutorial:c) "0.1"^^xsd:decimal)))
DLSafeRule(Annotation(swrla:isRuleEnabled "true"^^xsd:boolean) Annotation(rdfs:comment "Descuento especial para clientes que prefieren pizzas picantes") Annotation(rdfs:label "HotDiscountRule") Body(ClassAtom(pizzatutorial:Customer Variable(pizzatutorial:c)) DataPropertyAtom(pizzatutorial:numberOfPizzasPurchased Variable(pizzatutorial:c) Variable(pizzatutorial:np)) ObjectPropertyAtom(pizzatutorial:hasSpicinessPreference Variable(pizzatutorial:c) pizzatutorial:Hot) BuiltInAtom(swrlb:greaterThan Variable(pizzatutorial:np) "1"^^xsd:integer))Head(DataPropertyAtom(pizzatutorial:hasDiscount Variable(pizzatutorial:c) "0.2"^^xsd:decimal)))
DLSafeRule(Annotation(swrla:isRuleEnabled "true"^^xsd:boolean) Annotation(rdfs:comment "Dice que cliente obtendria el descuento por preferir pizzas picantes") Annotation(rdfs:label "QueryHotDiscount") Body(ClassAtom(pizzatutorial:Customer Variable(pizzatutorial:c)) DataPropertyAtom(pizzatutorial:numberOfPizzasPurchased Variable(pizzatutorial:c) Variable(pizzatutorial:np)) ObjectPropertyAtom(pizzatutorial:hasSpicinessPreference Variable(pizzatutorial:c) pizzatutorial:Hot) BuiltInAtom(swrlb:greaterThan Variable(pizzatutorial:np) "1"^^xsd:integer))Head(BuiltInAtom(<http://sqwrl.stanford.edu/ontologies/built-ins/3.4/sqwrl.owl#select> Variable(pizzatutorial:c) Variable(pizzatutorial:np))))
