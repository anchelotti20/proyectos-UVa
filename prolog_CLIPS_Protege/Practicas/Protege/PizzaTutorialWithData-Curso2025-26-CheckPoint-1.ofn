# Class: pizzatutorial:HighCaloriePizza (pizzatutorial:HighCaloriePizza)

EquivalentClasses(pizzatutorial:HighCaloriePizza ObjectIntersectionOf(pizzatutorial:Pizza DataSomeValuesFrom(pizzatutorial:hasCaloricContent DatatypeRestriction(xsd:integer xsd:minInclusive "400"^^xsd:integer))))

# Class: pizzatutorial:HotVeggiePizza (pizzatutorial:HotVeggiePizza)

EquivalentClasses(pizzatutorial:HotVeggiePizza ObjectIntersectionOf(pizzatutorial:VegetarianPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping ObjectHasValue(pizzatutorial:hasSpiciness pizzatutorial:Hot))))

# Class: pizzatutorial:InterestingPizza (pizzatutorial:InterestingPizza)

EquivalentClasses(pizzatutorial:InterestingPizza ObjectIntersectionOf(pizzatutorial:Pizza ObjectMinCardinality(3 pizzatutorial:hasTopping pizzatutorial:PizzaTopping)))

# Class: pizzatutorial:JalapenoPepperTopping (pizzatutorial:JalapenoPepperTopping)

SubClassOf(pizzatutorial:JalapenoPepperTopping pizzatutorial:PepperTopping)
