# Class: pizzatutorial:AmericanaHotPizza (pizzatutorial:AmericanaHotPizza)

AnnotationAssertion(rdfs:comment pizzatutorial:AmericanaHotPizza "A pizza that only has Mozzarella, Tomato, Jalapeno, and Pepperoni toppings")
SubClassOf(pizzatutorial:AmericanaHotPizza pizzatutorial:AmericanaPizza)
SubClassOf(pizzatutorial:AmericanaHotPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:JalapenoPepperTopping))
SubClassOf(pizzatutorial:AmericanaHotPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:MozzarellaTopping))
SubClassOf(pizzatutorial:AmericanaHotPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:PepperoniTopping))
SubClassOf(pizzatutorial:AmericanaHotPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:TomatoTopping))

# Class: pizzatutorial:AmericanaPizza (pizzatutorial:AmericanaPizza)

AnnotationAssertion(rdfs:comment pizzatutorial:AmericanaPizza "A pizza that only has Mozzarella, Tomato and Pepperoni toppings")
SubClassOf(pizzatutorial:AmericanaPizza pizzatutorial:NamedPizza)
SubClassOf(pizzatutorial:AmericanaPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:MozzarellaTopping))
SubClassOf(pizzatutorial:AmericanaPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:PepperoniTopping))
SubClassOf(pizzatutorial:AmericanaPizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:TomatoTopping))

# Class: pizzatutorial:AnchovyTopping (pizzatutorial:AnchovyTopping)

SubClassOf(pizzatutorial:AnchovyTopping pizzatutorial:SeafoodTopping)

# Class: pizzatutorial:CaperTopping (pizzatutorial:CaperTopping)

SubClassOf(pizzatutorial:CaperTopping pizzatutorial:VegetableTopping)
SubClassOf(pizzatutorial:CaperTopping ObjectHasValue(pizzatutorial:hasSpiciness pizzatutorial:Mild))

# Class: pizzatutorial:CheeseTopping (pizzatutorial:CheeseTopping)

SubClassOf(pizzatutorial:CheeseTopping pizzatutorial:PizzaTopping)
SubClassOf(pizzatutorial:CheeseTopping ObjectHasValue(pizzatutorial:hasSpiciness pizzatutorial:Mild))

# Class: pizzatutorial:CheesyPizza (pizzatutorial:CheesyPizza)

EquivalentClasses(pizzatutorial:CheesyPizza ObjectIntersectionOf(pizzatutorial:Pizza ObjectSomeValuesFrom(pizzatutorial:hasTopping pizzatutorial:CheeseTopping)))

# Class: pizzatutorial:Customer (pizzatutorial:Customer)

EquivalentClasses(pizzatutorial:Customer ObjectIntersectionOf(pizzatutorial:Person ObjectSomeValuesFrom(pizzatutorial:purchasedPizza pizzatutorial:Pizza) DataSomeValuesFrom(pizzatutorial:hasPhone xsd:string)))

# Class: pizzatutorial:DeepPanBase (pizzatutorial:DeepPanBase)

SubClassOf(pizzatutorial:DeepPanBase pizzatutorial:PizzaBase)
DisjointClasses(pizzatutorial:DeepPanBase pizzatutorial:ThinAndCrispyBase)

# Class: pizzatutorial:Employee (pizzatutorial:Employee)

SubClassOf(pizzatutorial:Employee ObjectIntersectionOf(pizzatutorial:Person DataMinCardinality(1 pizzatutorial:ssn xsd:string)))

# Class: pizzatutorial:GreenPepperTopping (pizzatutorial:GreenPepperTopping)

SubClassOf(pizzatutorial:GreenPepperTopping pizzatutorial:PepperTopping)
SubClassOf(pizzatutorial:GreenPepperTopping ObjectHasValue(pizzatutorial:hasSpiciness pizzatutorial:Medium))

# Class: pizzatutorial:HamTopping (pizzatutorial:HamTopping)

