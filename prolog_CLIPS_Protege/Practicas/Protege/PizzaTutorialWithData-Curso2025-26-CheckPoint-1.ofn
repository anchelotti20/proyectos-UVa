ObjectPropertyRange(pizzatutorial:hasTopping pizzatutorial:PizzaTopping)

# Object Property: pizzatutorial:isBaseOf (pizzatutorial:isBaseOf)

SubObjectPropertyOf(pizzatutorial:isBaseOf pizzatutorial:isIngredientOf)

# Object Property: pizzatutorial:isIngredientOf (pizzatutorial:isIngredientOf)

FunctionalObjectProperty(pizzatutorial:isIngredientOf)

# Object Property: pizzatutorial:isMilderThan (pizzatutorial:isMilderThan)

InverseObjectProperties(pizzatutorial:isMilderThan pizzatutorial:isSpicierThan)

# Object Property: pizzatutorial:isSpicierThan (pizzatutorial:isSpicierThan)

TransitiveObjectProperty(pizzatutorial:isSpicierThan)
ObjectPropertyDomain(pizzatutorial:isSpicierThan pizzatutorial:Spiciness)
ObjectPropertyRange(pizzatutorial:isSpicierThan pizzatutorial:Spiciness)

# Object Property: pizzatutorial:isToppingOf (pizzatutorial:isToppingOf)

SubObjectPropertyOf(pizzatutorial:isToppingOf pizzatutorial:isIngredientOf)

# Object Property: pizzatutorial:purchasedByCustomer (pizzatutorial:purchasedByCustomer)

InverseObjectProperties(pizzatutorial:purchasedByCustomer pizzatutorial:purchasedPizza)
