# Object Property: pizzatutorial:hasBase (pizzatutorial:hasBase)

SubObjectPropertyOf(pizzatutorial:hasBase pizzatutorial:hasIngredient)
InverseObjectProperties(pizzatutorial:hasBase pizzatutorial:isBaseOf)
ObjectPropertyDomain(pizzatutorial:hasBase pizzatutorial:Pizza)
ObjectPropertyRange(pizzatutorial:hasBase pizzatutorial:PizzaBase)

# Object Property: pizzatutorial:hasIngredient (pizzatutorial:hasIngredient)

InverseObjectProperties(pizzatutorial:hasIngredient pizzatutorial:isIngredientOf)

# Object Property: pizzatutorial:hasSpiciness (pizzatutorial:hasSpiciness)

ObjectPropertyDomain(pizzatutorial:hasSpiciness pizzatutorial:PizzaTopping)
ObjectPropertyRange(pizzatutorial:hasSpiciness pizzatutorial:Spiciness)

# Object Property: pizzatutorial:hasSpicinessPreference (pizzatutorial:hasSpicinessPreference)

ObjectPropertyDomain(pizzatutorial:hasSpicinessPreference pizzatutorial:Customer)
ObjectPropertyRange(pizzatutorial:hasSpicinessPreference pizzatutorial:Spiciness)

# Object Property: pizzatutorial:hasTopping (pizzatutorial:hasTopping)

SubObjectPropertyOf(pizzatutorial:hasTopping pizzatutorial:hasIngredient)
