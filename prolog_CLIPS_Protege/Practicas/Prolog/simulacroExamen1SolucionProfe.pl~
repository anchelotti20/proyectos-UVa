transita(Qi, [X|Y], R, Qf, T):-  /*Ademas para de derecha a izquierda,
                                   hay que invertir todas las clausulas que
                                   impliquen varias clausulas*/

    transita(P, Y, S, Qf, T),
    mueve(Qi, X, R, P, S),
    X \= [].

